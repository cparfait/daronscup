// DaronsFC — schéma Prisma
// Doc: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// Saisons (compétitions successives)
//
// L'app suit UNE compétition à la fois : la saison `active`. Les saisons
// précédentes sont `closedAt` et consultables en archive. Tout ce qui est
// propre à une compétition (matchs, groupes d'amis, palmarès) est rattaché à
// une saison ; les agrégats de jeu (Score, UserBadge, ChampionPick) sont un
// CACHE de la saison active, figé dans `SeasonArchive` à la clôture.
// ─────────────────────────────────────────────

model Season {
  id        String     @id @default(cuid())
  code      String     @unique // "WC-2026", "CL-2026-2027"
  name      String // "Coupe du Monde 2026"
  shortName String // "CdM 2026"
  kind      SeasonKind @default(NATIONS) // NATIONS = drapeaux, CLUBS = écussons
  emoji     String     @default("🏆") // repli quand `logo` est absent
  // Logo de la compétition, chemin servi depuis `public/` (ex. "/seasons/c1.svg").
  // Doit être transparent et lisible sur fond sombre. Null → on affiche l'emoji.
  logo      String?

  // ── Sources de données ──
  competition String // code football-data.org ("WC", "CL")
  // Année de départ de la saison côté API (`?season=2026`). Indispensable pour
  // les compétitions annuelles : sans ça, l'API renvoie sa « currentSeason »,
  // qui peut être l'édition précédente.
  apiSeason   String?
  // Clé sport The Odds API ("soccer_fifa_world_cup", "soccer_uefa_champs_league").
  oddsSport   String?

  // ── Règles du jeu propres à la saison ──
  jokerLeagueBudget   Int @default(4) // poules / phase de ligue
  jokerKnockoutBudget Int @default(2) // phase à élimination directe
  championBonus       Int @default(50)

  active    Boolean   @default(false) // une seule saison active à la fois
  closedAt  DateTime?
  createdAt DateTime  @default(now())

  matches          Match[]
  groups           Group[]
  archive          SeasonArchive?
  championOverride ChampionOverride?

  @@index([active])
}

// Palmarès FIGÉ d'une saison clôturée : classement final par groupe d'amis,
// champions pariés, badges décernés, stats. Permet de vider les agrégats
// (Score / UserBadge / ChampionPick) pour la saison suivante sans rien perdre.
model SeasonArchive {
  seasonId  String   @id
  data      Json
  createdAt DateTime @default(now())
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// Domaine métier
// ─────────────────────────────────────────────

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String? // requis par l'adapter NextAuth (avatar OAuth)
  avatarUrl     String? // avatar affiché dans l'app (alias métier)
  passwordHash  String? // auth email/password (null pour comptes OAuth seuls)
  googleId      String?      @unique
  role          Role         @default(USER)
  banned        Boolean      @default(false)
  createdAt     DateTime     @default(now())
  lastSeenAt    DateTime? // présence : dernier heartbeat (compte « en ligne »)

  predictions   Prediction[]
  messages      Message[]
  reactions     Reaction[]
  badges        UserBadge[]
  pushSubs      PushSubscription[]
  score         Score?
  championPick  ChampionPick?
  groupMemberships GroupMember[]

  accounts      Account[]
  sessions      Session[]
}

// ─────────────────────────────────────────────
// Groupes d'amis
// ─────────────────────────────────────────────

model Group {
  id        String        @id @default(cuid())
  name      String
  token     String        @unique // lien d'invitation unique et stable
  createdBy String
  createdAt DateTime      @default(now())
  // Saison du groupe : chaque saison a ses propres groupes (donc son classement
  // et son tchat). `null` = groupe hérité d'avant les saisons (rattaché au
  // démarrage par `bootstrapSeasons`).
  seasonId  String?
  season    Season?       @relation(fields: [seasonId], references: [id])
  members   GroupMember[]
  messages  Message[]

  @@index([seasonId])
}

model GroupMember {
  groupId  String
  userId   String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

model Match {
  id          String       @id @default(cuid())
  homeTeam    String
  awayTeam    String
  // Emblème de l'équipe : soit un CODE drapeau flagcdn ("fr", "gb-eng") pour une
  // sélection nationale, soit une URL d'écusson de club (crests.football-data.org).
  // Le composant <Flag> gère les deux (cf. lib/flags.ts → `isCrestUrl`).
  homeFlag    String
  awayFlag    String
  kickoffAt   DateTime
  stage       Stage
  group       String?
  matchday    Int? // numéro de journée (pour le joker / filtres)
  // Saison de rattachement. `null` = match hérité d'avant les saisons (rattaché
  // au démarrage par `bootstrapSeasons`).
  seasonId    String?
  season      Season?      @relation(fields: [seasonId], references: [id])
  externalId  Int?         @unique // id API-Football (clé d'idempotence du sync)
  // Cotes 1X2 figées (The Odds API) — servent au scoring « façon MPP » : plus
  // l'issue est improbable, plus le bon résultat rapporte. Capturées ~toutes
  // les 6 h jusqu'au coup d'envoi, puis figées (closing odds).
  oddsHome       Float?
  oddsDraw       Float?
  oddsAway       Float?
  oddsCapturedAt DateTime?
  predictions Prediction[]
  result      Result?

  @@index([kickoffAt])
  @@index([seasonId, kickoffAt])
}

model Prediction {
  id          String   @id @default(cuid())
  userId      String
  matchId     String
  homeScore   Int
  awayScore   Int
  joker         Boolean  @default(false)
  penaltyPick   String?  // "home" | "away" — vainqueur aux tirs (élimination directe)
  comment       String?  // visible uniquement après coup d'envoi (anti-influence)
  pointsAwarded Int?     // null tant que le match n'est pas terminé
  submittedAt DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([matchId])
}

model Result {
  matchId   String     @id
  homeScore     Int
  awayScore     Int
  penaltyWinner String?     // "home" | "away" — vainqueur aux tirs au but
  status        MatchStatus @default(SCHEDULED)
  notified      Boolean     @default(false) // notif push résultat déjà envoyée ?
  updatedAt DateTime   @default(now()) @updatedAt
  match     Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model Score {
  userId         String @id
  points         Int    @default(0)
  exactScores    Int    @default(0)
  correctResults Int    @default(0)
  previousRank   Int? // rang avant le dernier match terminé (pour l'évolution ▲▼)
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Pari « vainqueur du tournoi » : un seul choix par joueur, définitif, qui
// rapporte un bonus (CHAMPION_BONUS) si l'équipe choisie gagne la finale.
model ChampionPick {
  userId    String   @id
  team      String // nom de l'équipe (affichage)
  flag      String // code drapeau (fr, br, …)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Vainqueur du tournoi désigné MANUELLEMENT par un admin — pour le cas d'une
// finale gagnée aux tirs au but (score nul, vainqueur indéductible du score
// fourni par l'API). Un au plus par saison. Prioritaire sur le score.
//
// `id` reste "singleton" pour la ligne héritée d'avant les saisons ; les
// nouvelles saisons utilisent un cuid. La clé métier est `seasonId`.
model ChampionOverride {
  id       String   @id @default("singleton")
  team     String
  flag     String
  setAt    DateTime @default(now()) @updatedAt
  seasonId String?  @unique
  season   Season?  @relation(fields: [seasonId], references: [id], onDelete: Cascade)
}

model Message {
  id        String     @id @default(cuid())
  userId    String
  groupId   String? // tchat propre à un groupe (null = ancien tchat global)
  content   String
  pinned    Boolean    @default(false)
  isSystem  Boolean    @default(false) // message auto → rendu en bandeau
  systemKind String? // "RECAP" — distingue les messages auto
  matchId   String? // message rattaché à un match → idempotence (1 / match / groupe / kind)
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     Group?     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  reactions Reaction[]

  @@index([createdAt])
  @@index([groupId, createdAt])
  @@index([groupId, matchId])
}

model Reaction {
  id        String  @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

model Badge {
  id          String      @id @default(cuid())
  key         String      @unique // "nostradamus" | "daronissime" | "meme_pas_mal" | "sniper"
  label       String
  emoji       String
  description String
  users       UserBadge[]
}

model UserBadge {
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
}

model Invite {
  id        String   @id @default(cuid())
  token     String   @unique
  createdBy String
  expiresAt DateTime?
  usesLeft  Int? // null = illimité
  createdAt DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// NextAuth (adapter Prisma)
// ─────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum GroupRole {
  OWNER
  MEMBER
}

enum SeasonKind {
  NATIONS // sélections nationales → drapeaux (Coupe du Monde, Euro…)
  CLUBS //   clubs → écussons (Ligue des Champions…)
}

enum Stage {
  GROUP //   phase de poules (CdM)
  LEAGUE //  phase de ligue (C1 : 36 clubs, un seul classement, 8 journées)
  PLAYOFF // barrages d'accès aux 8èmes (C1), en aller-retour
  ROUND_OF_32
  ROUND_OF_16
  QUARTER
  SEMI
  THIRD_PLACE
  FINAL
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
}
